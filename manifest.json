{
  "manifest_version": 3,
  "name": "LeetCode Problem Copier",
  "version": "1.0.0",
  "description": "一键复制 LeetCode 题目为 Markdown 格式",
  "permissions": ["activeTab", "clipboardWrite"],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://leetcode.cn/problems/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}
